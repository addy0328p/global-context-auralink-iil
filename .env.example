HTTP_HOST=127.0.0.1
HTTP_PORT=8080

PGHOST=localhost
PGPORT=5433
PGDATABASE=auralink_context
PGUSER=auralink_app
PGPASSWORD=REPLACE_ME
PGSSLMODE=disable

SELLER_DATASET_ZIP=
BUYER_DATASET_CSV=
# Leave blank until the timezone of the dataset timestamps is confirmed.
SOURCE_TIMEZONE=

# Generate both local secrets with: go run ./cmd/apiconfig
# These are backend access tokens, separate from your Sarvam account API key.
DEMO_API_BEARER_TOKEN=
SARVAM_TOOL_BEARER_TOKEN=
DEMO_SUBJECT_MANIFEST=artifacts/exports/historical_dataset/manifest.json

# Sarvam connection configuration. Fill credentials only in your private .env.
# Voice Agents and Model APIs may require different credentials.
SARVAM_VOICE_API_KEY=
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_SELLER_APP_ID=
SARVAM_BUYER_APP_ID=
SARVAM_SELLER_AGENT_VERSION=
SARVAM_BUYER_AGENT_VERSION=
